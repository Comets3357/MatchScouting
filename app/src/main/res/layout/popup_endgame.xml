<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <ImageView
        android:id="@+id/imageViewCages"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:alpha="0.8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cages" />

    <Button
        android:id="@+id/buttonCancelEndgame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#706868"
        android:text="Cancel"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ToggleButton
        android:id="@+id/buttonShallowCage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="120dp"
        android:layout_marginTop="120dp"
        android:background="@drawable/toggle_button_drawable"
        android:text="Shallow Climb"
        android:textOff="SHALLOW CLIMB"
        android:textOn="SHALLOW CLIMB"
        app:layout_constraintStart_toStartOf="@+id/imageViewCages"
        app:layout_constraintTop_toTopOf="@+id/imageViewCages" />

    <ToggleButton
        android:id="@+id/buttonDeepCage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="120dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/toggle_button_drawable"
        android:text="Deep Climb"
        android:textOff="DEEP CLIMB"
        android:textOn="DEEP CLIMB"
        app:layout_constraintBottom_toBottomOf="@+id/imageViewCages"
        app:layout_constraintEnd_toEndOf="@+id/imageViewCages" />

    <ToggleButton
        android:id="@+id/buttonNoClimb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/toggle_button_drawable"
        android:text="No Climb"
        android:textOff="NO CLIMB"
        android:textOn="NO CLIMB"
        app:layout_constraintBottom_toBottomOf="@+id/imageViewCages"
        app:layout_constraintStart_toStartOf="@+id/imageViewCages" />


</androidx.constraintlayout.widget.ConstraintLayout>